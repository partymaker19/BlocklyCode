<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_number">number</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="var_number">number</field>
    <value name="VALUE">
      <shadow type="math_number">
        <field name="NUM">42</field>
      </shadow>
    </value>
    <next>
      <block type="controls_if">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_compare">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="math_modulo">
                <value name="DIVIDEND">
                  <block type="variables_get">
                    <field name="VAR" id="var_number">number</field>
                  </block>
                </value>
                <value name="DIVISOR">
                  <shadow type="math_number">
                    <field name="NUM">2</field>
                  </shadow>
                </value>
              </block>
            </value>
            <value name="B">
              <shadow type="math_number">
                <field name="NUM">0</field>
              </shadow>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="add_text">
            <value name="TEXT">
              <shadow type="text">
                <field name="TEXT">The number is even</field>
              </shadow>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="add_text">
            <value name="TEXT">
              <shadow type="text">
                <field name="TEXT">The number is odd</field>
              </shadow>
            </value>
          </block>
        </statement>
        <next>
          <block type="controls_if">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_compare">
                <field name="OP">GT</field>
                <value name="A">
                  <block type="variables_get">
                    <field name="VAR" id="var_number">number</field>
                  </block>
                </value>
                <value name="B">
                  <shadow type="math_number">
                    <field name="NUM">0</field>
                  </shadow>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="add_text">
                <value name="TEXT">
                  <shadow type="text">
                    <field name="TEXT">The number is positive</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="add_text">
                <value name="TEXT">
                  <shadow type="text">
                    <field name="TEXT">The number is negative</field>
                  </shadow>
                </value>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
