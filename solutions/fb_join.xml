<?xml version="1.0" encoding="UTF-8"?>
<!--
  Задача 28 (fb_join): исправленная программа.
  Баг был в порядке частей: «World!» стояла раньше «Hello, ».
  Вывод: Hello, World!
-->
<xml xmlns="https://developers.google.com/blockly/xml">
  <block type="add_text" x="40" y="40">
    <value name="TEXT">
      <block type="text_join">
        <mutation items="2"></mutation>
        <value name="ADD0">
          <block type="text"><field name="TEXT">Hello, </field></block>
        </value>
        <value name="ADD1">
          <block type="text"><field name="TEXT">World!</field></block>
        </value>
      </block>
    </value>
  </block>
</xml>
