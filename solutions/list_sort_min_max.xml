<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_numbers">numbers</variable>
    <variable id="var_sorted">sorted</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="var_numbers">numbers</field>
    <value name="VALUE">
      <block type="lists_create_with">
        <mutation items="5"></mutation>
        <value name="ADD0"><shadow type="math_number"><field name="NUM">9</field></shadow></value>
        <value name="ADD1"><shadow type="math_number"><field name="NUM">3</field></shadow></value>
        <value name="ADD2"><shadow type="math_number"><field name="NUM">7</field></shadow></value>
        <value name="ADD3"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
        <value name="ADD4"><shadow type="math_number"><field name="NUM">5</field></shadow></value>
      </block>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR" id="var_sorted">sorted</field>
        <value name="VALUE">
          <block type="lists_sort">
            <field name="TYPE">NUMERIC</field>
            <field name="DIRECTION">1</field>
            <value name="LIST">
              <block type="variables_get"><field name="VAR" id="var_numbers">numbers</field></block>
            </value>
          </block>
        </value>
        <next>
          <block type="add_text">
            <value name="TEXT">
              <block type="text_join">
                <mutation items="2"></mutation>
                <value name="ADD0"><shadow type="text"><field name="TEXT">min: </field></shadow></value>
                <value name="ADD1">
                  <block type="lists_getIndex">
                    <mutation at="true"></mutation>
                    <field name="MODE">GET</field>
                    <field name="WHERE">FROM_START</field>
                    <value name="VALUE">
                      <block type="variables_get"><field name="VAR" id="var_sorted">sorted</field></block>
                    </value>
                    <value name="AT">
                      <block type="math_number"><field name="NUM">1</field></block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="add_text">
                <value name="TEXT">
                  <block type="text_join">
                    <mutation items="2"></mutation>
                    <value name="ADD0"><shadow type="text"><field name="TEXT">max: </field></shadow></value>
                    <value name="ADD1">
                      <block type="lists_getIndex">
                        <mutation at="true"></mutation>
                        <field name="MODE">GET</field>
                        <field name="WHERE">FROM_START</field>
                        <value name="VALUE">
                          <block type="variables_get"><field name="VAR" id="var_sorted">sorted</field></block>
                        </value>
                        <value name="AT">
                          <block type="lists_length">
                            <value name="VALUE">
                              <block type="variables_get"><field name="VAR" id="var_sorted">sorted</field></block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
