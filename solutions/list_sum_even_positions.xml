<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_list">list</variable>
    <variable id="var_i">i</variable>
    <variable id="var_sum">sum</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="var_list">list</field>
    <value name="VALUE">
      <block type="lists_create_with">
        <mutation items="10"></mutation>
        <value name="ADD0"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
        <value name="ADD1"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
        <value name="ADD2"><shadow type="math_number"><field name="NUM">8</field></shadow></value>
        <value name="ADD3"><shadow type="math_number"><field name="NUM">2</field></shadow></value>
        <value name="ADD4"><shadow type="math_number"><field name="NUM">7</field></shadow></value>
        <value name="ADD5"><shadow type="math_number"><field name="NUM">3</field></shadow></value>
        <value name="ADD6"><shadow type="math_number"><field name="NUM">6</field></shadow></value>
        <value name="ADD7"><shadow type="math_number"><field name="NUM">4</field></shadow></value>
        <value name="ADD8"><shadow type="math_number"><field name="NUM">5</field></shadow></value>
        <value name="ADD9"><shadow type="math_number"><field name="NUM">9</field></shadow></value>
      </block>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR" id="var_sum">sum</field>
        <value name="VALUE"><shadow type="math_number"><field name="NUM">0</field></shadow></value>
        <next>
          <block type="controls_for">
            <field name="VAR" id="var_i">i</field>
            <value name="FROM"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
            <value name="TO"><shadow type="math_number"><field name="NUM">10</field></shadow></value>
            <value name="BY"><shadow type="math_number"><field name="NUM">1</field></shadow></value>
            <statement name="DO">
              <block type="controls_if">
                <value name="IF0">
                  <block type="logic_compare">
                    <field name="OP">EQ</field>
                    <value name="A">
                      <block type="math_modulo">
                        <value name="DIVIDEND">
                          <block type="variables_get"><field name="VAR" id="var_i">i</field></block>
                        </value>
                        <value name="DIVISOR">
                          <shadow type="math_number"><field name="NUM">2</field></shadow>
                        </value>
                      </block>
                    </value>
                    <value name="B">
                      <shadow type="math_number"><field name="NUM">0</field></shadow>
                    </value>
                  </block>
                </value>
                <statement name="DO0">
                  <block type="math_change">
                    <field name="VAR" id="var_sum">sum</field>
                    <value name="DELTA">
                      <block type="lists_getIndex">
                        <mutation at="true" statement="false"></mutation>
                        <field name="MODE">GET</field>
                        <field name="WHERE">FROM_START</field>
                        <value name="VALUE">
                          <block type="variables_get"><field name="VAR" id="var_list">list</field></block>
                        </value>
                        <value name="AT">
                          <block type="variables_get"><field name="VAR" id="var_i">i</field></block>
                        </value>
                      </block>
                    </value>
                  </block>
                </statement>
              </block>
            </statement>
            <next>
              <block type="add_text">
                <value name="TEXT">
                  <block type="text_join">
                    <mutation items="2"></mutation>
                    <value name="ADD0"><shadow type="text"><field name="TEXT">sum=</field></shadow></value>
                    <value name="ADD1">
                      <block type="variables_get"><field name="VAR" id="var_sum">sum</field></block>
                    </value>
                  </block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
