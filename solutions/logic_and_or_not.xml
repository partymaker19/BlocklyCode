<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!--
    Задача 36 (logic_and_or_not): три утверждения о числе 14.
    «И» требует обеих частей, «или» — одной, «не» переворачивает ответ.
    Ожидаемый вывод: NO, YES, NO
  -->
  <block type="controls_if" x="40" y="40">
    <mutation else="1"></mutation>
    <value name="IF0">
      <block type="logic_operation">
        <field name="OP">AND</field>
        <value name="A">
          <block type="logic_compare">
            <field name="OP">GT</field>
            <value name="A">
              <shadow type="math_number">
                <field name="NUM">14</field>
              </shadow>
            </value>
            <value name="B">
              <shadow type="math_number">
                <field name="NUM">10</field>
              </shadow>
            </value>
          </block>
        </value>
        <value name="B">
          <block type="logic_compare">
            <field name="OP">LT</field>
            <value name="A">
              <shadow type="math_number">
                <field name="NUM">14</field>
              </shadow>
            </value>
            <value name="B">
              <shadow type="math_number">
                <field name="NUM">12</field>
              </shadow>
            </value>
          </block>
        </value>
      </block>
    </value>
    <statement name="DO0">
      <block type="add_text">
        <value name="TEXT">
          <shadow type="text">
            <field name="TEXT">YES</field>
          </shadow>
        </value>
      </block>
    </statement>
    <statement name="ELSE">
      <block type="add_text">
        <value name="TEXT">
          <shadow type="text">
            <field name="TEXT">NO</field>
          </shadow>
        </value>
      </block>
    </statement>
    <next>
      <block type="controls_if">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="logic_operation">
            <field name="OP">OR</field>
            <value name="A">
              <block type="logic_compare">
                <field name="OP">GT</field>
                <value name="A">
                  <shadow type="math_number">
                    <field name="NUM">14</field>
                  </shadow>
                </value>
                <value name="B">
                  <shadow type="math_number">
                    <field name="NUM">20</field>
                  </shadow>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="logic_compare">
                <field name="OP">LT</field>
                <value name="A">
                  <shadow type="math_number">
                    <field name="NUM">14</field>
                  </shadow>
                </value>
                <value name="B">
                  <shadow type="math_number">
                    <field name="NUM">15</field>
                  </shadow>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="add_text">
            <value name="TEXT">
              <shadow type="text">
                <field name="TEXT">YES</field>
              </shadow>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="add_text">
            <value name="TEXT">
              <shadow type="text">
                <field name="TEXT">NO</field>
              </shadow>
            </value>
          </block>
        </statement>
        <next>
          <block type="controls_if">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_negate">
                <value name="BOOL">
                  <block type="logic_compare">
                    <field name="OP">GT</field>
                    <value name="A">
                      <shadow type="math_number">
                        <field name="NUM">14</field>
                      </shadow>
                    </value>
                    <value name="B">
                      <shadow type="math_number">
                        <field name="NUM">13</field>
                      </shadow>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <block type="add_text">
                <value name="TEXT">
                  <shadow type="text">
                    <field name="TEXT">YES</field>
                  </shadow>
                </value>
              </block>
            </statement>
            <statement name="ELSE">
              <block type="add_text">
                <value name="TEXT">
                  <shadow type="text">
                    <field name="TEXT">NO</field>
                  </shadow>
                </value>
              </block>
            </statement>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
