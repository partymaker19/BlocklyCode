<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <!--
    Задача 8 (math_round_clamp): четыре вида округления и два ограничения.
    Числа без .5 посередине — Python округляет «до чётного», остальные языки вверх.
    Ожидаемый вывод: 4, 5, 5, 4, 100, 0
  -->
  <block type="add_text" x="40" y="40">
    <value name="TEXT">
      <block type="math_round">
        <field name="OP">ROUND</field>
        <value name="NUM">
          <shadow type="math_number">
            <field name="NUM">4.4</field>
          </shadow>
        </value>
      </block>
    </value>
    <next>
      <block type="add_text">
        <value name="TEXT">
          <block type="math_round">
            <field name="OP">ROUND</field>
            <value name="NUM">
              <shadow type="math_number">
                <field name="NUM">4.6</field>
              </shadow>
            </value>
          </block>
        </value>
        <next>
          <block type="add_text">
            <value name="TEXT">
              <block type="math_round">
                <field name="OP">ROUNDUP</field>
                <value name="NUM">
                  <shadow type="math_number">
                    <field name="NUM">4.1</field>
                  </shadow>
                </value>
              </block>
            </value>
            <next>
              <block type="add_text">
                <value name="TEXT">
                  <block type="math_round">
                    <field name="OP">ROUNDDOWN</field>
                    <value name="NUM">
                      <shadow type="math_number">
                        <field name="NUM">4.9</field>
                      </shadow>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="add_text">
                    <value name="TEXT">
                      <block type="math_constrain">
                        <value name="VALUE">
                          <shadow type="math_number">
                            <field name="NUM">150</field>
                          </shadow>
                        </value>
                        <value name="LOW">
                          <shadow type="math_number">
                            <field name="NUM">0</field>
                          </shadow>
                        </value>
                        <value name="HIGH">
                          <shadow type="math_number">
                            <field name="NUM">100</field>
                          </shadow>
                        </value>
                      </block>
                    </value>
                    <next>
                      <block type="add_text">
                        <value name="TEXT">
                          <block type="math_constrain">
                            <value name="VALUE">
                              <shadow type="math_number">
                                <field name="NUM">-5</field>
                              </shadow>
                            </value>
                            <value name="LOW">
                              <shadow type="math_number">
                                <field name="NUM">0</field>
                              </shadow>
                            </value>
                            <value name="HIGH">
                              <shadow type="math_number">
                                <field name="NUM">100</field>
                              </shadow>
                            </value>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
