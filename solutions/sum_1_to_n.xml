<?xml version="1.0" encoding="UTF-8"?>
<xml xmlns="https://developers.google.com/blockly/xml">
  <variables>
    <variable id="var_n">n</variable>
    <variable id="var_i">i</variable>
    <variable id="var_sum">sum</variable>
  </variables>
  <block type="variables_set" x="40" y="40">
    <field name="VAR" id="var_sum">sum</field>
    <value name="VALUE">
      <shadow type="math_number"><field name="NUM">0</field></shadow>
    </value>
    <next>
      <block type="variables_set">
        <field name="VAR" id="var_n">n</field>
        <value name="VALUE">
          <shadow type="math_number"><field name="NUM">5</field></shadow>
        </value>
        <next>
          <block type="controls_for">
            <field name="VAR" id="var_i">i</field>
            <value name="FROM">
              <shadow type="math_number"><field name="NUM">1</field></shadow>
            </value>
            <value name="TO">
              <block type="variables_get"><field name="VAR" id="var_n">n</field></block>
            </value>
            <value name="BY">
              <shadow type="math_number"><field name="NUM">1</field></shadow>
            </value>
            <statement name="DO">
              <block type="math_change">
                <field name="VAR" id="var_sum">sum</field>
                <value name="DELTA">
                  <block type="variables_get"><field name="VAR" id="var_i">i</field></block>
                </value>
              </block>
            </statement>
            <next>
              <block type="add_text">
                <value name="TEXT">
                  <block type="variables_get"><field name="VAR" id="var_sum">sum</field></block>
                </value>
              </block>
            </next>
          </block>
        </next>
      </block>
    </next>
  </block>
</xml>
